# Ignore generated HTML or markdown reports
*.html linguist-documentation=true
*.md linguist-documentation=true

# Force GitHub to detect R and Python files properly
*.Rmd linguist-detectable=false
*.Rmd linguist-language=R
*.ipynb linguist-language=Python

# Override vendor paths if you have knitted folders
docs/* linguist-vendored
site_libs/* linguist-vendored


